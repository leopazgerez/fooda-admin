# URL base de la API del backend (ej: http://localhost:8080/api o https://api.tudominio.com/api)
# Prototipo sin backend: NEXT_PUBLIC_API_URL=mock (servidor simulado en el navegador, datos en localStorage,
# usuario admin@fooda.com / contraseña demo; "Restaurar datos de ejemplo" = POST /mock/reset).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Sub-ruta para GitHub Pages (ej: /mi-admin). En local o con dominio propio, dejar vacío.
# En GitHub Actions se deriva sola del nombre del repo.
NEXT_PUBLIC_BASE_PATH=
